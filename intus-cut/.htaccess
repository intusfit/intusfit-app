# Intus Cut: editor de vídeo da equipe (acesso conferido pela API com o login do painel)
<IfModule mod_headers.c>
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), fullscreen=(self)"
  Header set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
