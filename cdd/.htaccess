# CDD (Codigo da Definicao): pasta propria, nada da Intus e editado. Regras so desta pasta.
Options -Indexes
# Em intusfit.com.br/cdd (espelho) nao indexar; no dominio proprio do CDD pode indexar.
<IfModule mod_setenvif.c>
SetEnvIfNoCase Host ^(www\.)?codigodadefinicao\.com\.br$ CDD_PROPRIO
</IfModule>
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow" env=!CDD_PROPRIO
</IfModule>
# Testes e dados de importacao nao sao do site.
<FilesMatch "\.(json|sql|sh|md|bak|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>
# O manifesto do app web e publico.
<FilesMatch "^manifest\.webmanifest$">
    Order deny,allow
    Allow from all
</FilesMatch>
# Acesso da equipe: /painel (o arquivo painel.html continua sendo o mesmo, so muda o endereco que se ve e divulga).
<IfModule mod_rewrite.c>
RewriteEngine On
# Endereco antigo (intusfit.com.br/cdd) leva ao dominio proprio. O Worker do dominio do CDD busca o conteudo aqui e manda X-CDD-Base, por isso ele passa direto (sem isso daria laco).
RewriteCond %{HTTP:X-CDD-Base} ^$
RewriteCond %{HTTP_HOST} ^(www\.)?intusfit\.com\.br$ [NC]
RewriteRule ^(.*)$ https://codigodadefinicao.com.br/app/$1 [R=302,L]
RewriteCond %{THE_REQUEST} "^[A-Z]+ [^ ]*/painel(\.html|/)[ ?]"
RewriteCond %{REQUEST_URI} ^(.*)/painel(\.html|/)$
RewriteRule ^painel(\.html|/)$ %1/painel [R=302,L]
RewriteRule ^painel$ painel.html [L]
# Páginas públicas do CDD sem .html: /vendas (landing) e /captura (formulário de leads)
RewriteRule ^vendas$ vendas.html [L]
RewriteRule ^captura$ captura.html [L]
</IfModule>
