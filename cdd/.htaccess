# CDD (Codigo da Definicao): pasta propria, nada da Intus e editado. Regras so desta pasta.
Options -Indexes
# Enquanto o CDD esta em construcao em intusfit.com.br/cdd, nao indexar. Remover esta linha quando o dominio proprio entrar no ar.
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# Testes e dados de importacao nao sao do site.
<FilesMatch "\.(json|sql|sh|md|bak|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>
# O manifesto do app web e publico.
<FilesMatch "^manifest\.webmanifest$">
    Order deny,allow
    Allow from all
</FilesMatch>
