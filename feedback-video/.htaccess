# O .htaccess da raiz bloqueia o microfone no site inteiro (microphone=()).
# Só esta ferramenta precisa de microfone, câmera e captura de tela — libera aqui,
# sem abrir nada para o resto do site.
<IfModule mod_headers.c>
Header always set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
</IfModule>

# Sempre busca a versão nova da tela: sem isto o navegador podia continuar abrindo a
# versão antiga guardada em cache depois de uma correção publicada.
<IfModule mod_headers.c>
Header always set Cache-Control "no-cache, must-revalidate"
</IfModule>
