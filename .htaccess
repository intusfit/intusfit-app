RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Security headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# (self) = so o proprio site pode pedir (e o navegador sempre pergunta antes); sites de fora
# continuam sem acesso. microphone: /feedback-video/ grava a voz do professor. geolocation: o
# Cardio ao vivo e o mapa de local do Feed, no aluno.html, usam o GPS (antes "()" recusava
# em silencio na versao web do app).
Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# CSP parcial (14/10/2026): impede <base> injetado, plugins (<object>/<embed>) e o site dentro de iframe de outro domínio. A CSP completa (script-src) exige tirar os scripts embutidos das telas e fica para depois.
Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# Pastas internas (ferramentas, testes e código do app nativo) não são do site: respondem 403. `erros/` (páginas de erro) continua público.
RewriteRule ^(tools|testes|mobile)(/|$) - [F,L]
# Pastas desativadas que ainda existem no servidor (cópia velha do painel de maio, apontando para a API de produção): 403 até o Luiz apagar pelo gerenciador de arquivos da KingHost.
RewriteRule ^app/_removido-[^/]*(/|$) - [F,L]

# Documentação interna, scripts e cópias antigas das telas não devem ser servidos (CLAUDE.md tinha nomes de servidor, de banco e detalhes de segurança).
<FilesMatch "\.(md|py|sh|ps1|bak|sql|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
<FilesMatch "-(old|bug)[-0-9a-z]*\.html$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "(\.env|\.git|\.htpasswd|\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>
