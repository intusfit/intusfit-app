<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): nada do app vai para o backup na nuvem nem para a transferência entre aparelhos.
     O WebView guarda no armazenamento local o token de sessão do aluno e dados do treino; restaurar isso em outro aparelho
     entregaria uma sessão válida sem login. No aparelho novo o aluno entra de novo. Combina com android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
