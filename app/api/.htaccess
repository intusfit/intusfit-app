# Bloqueia acesso direto a arquivos sensíveis
<FilesMatch "\.(py|env|ini|log|sql|bak)$">
    Require all denied
</FilesMatch>

# Bibliotecas internas (prefixo "_") não são endpoints: nunca devem ser abertas pelo navegador (a carona de backup, por exemplo, rodava ao ser acessada).
<FilesMatch "^_.*\.php$">
    Require all denied
</FilesMatch>

<Files "config.php">
    Require all denied
</Files>

<Files "db.php">
    Require all denied
</Files>
