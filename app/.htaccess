RewriteEngine On

# Pasta desativada que ainda existe no servidor (cópia velha do painel de maio, ligada à API de produção): 403 até ser apagada pelo gerenciador de arquivos da KingHost.
RewriteRule ^_removido-[^/]*(/|$) - [F,L]

# Pastas de upload só guardam imagem: nenhum script pode ser executado ou baixado de dentro delas.
RewriteRule ^(img|uploads|painel/uploads)/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|htaccess)$ - [F,L]

# Link do professor: /app/loginprof abre o acesso do professor (a tela de cliente não mostra mais "Sou professor").
RewriteRule ^loginprof/?$ /app/painel/login.html?professor=1 [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /app/painel/login.html [R=302,L]

# Figurinhas e fotos publicas (24/11/2026): o app das lojas roda em capacitor://localhost (iPhone) e https://localhost (Android).
# Para desenhar a figurinha dentro da foto compartilhada (canvas), o navegador exige este cabecalho. Vale so para imagens de app/img,
# e so para as origens do proprio app (nada de "*").
<IfModule mod_headers.c>
SetEnvIf Origin "^(capacitor://localhost|https://localhost|http://localhost)$" INTUS_APP_ORIGEM=$0
<FilesMatch "\.(png|jpe?g|gif|webp|svg)$">
Header set Access-Control-Allow-Origin "%{INTUS_APP_ORIGEM}e" env=INTUS_APP_ORIGEM
Header append Vary Origin
</FilesMatch>
</IfModule>
