RewriteEngine On

# Pastas de upload só guardam imagem: nenhum script pode ser executado ou baixado de dentro delas.
RewriteRule ^(img|uploads|painel/uploads)/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|htaccess)$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /app/painel/login.html [R=302,L]
